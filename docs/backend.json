
{
  "entities": {
    "SiteSettings": {
      "title": "Site Settings",
      "description": "General configuration for the foundation website.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contactPhone": { "type": "string" },
        "address": { "type": "string" },
        "officeHours": { "type": "string" }
      }
    },
    "SiteContent": {
      "title": "Site Content",
      "description": "Miscellaneous page content and static-style imagery.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" }
      }
    },
    "Initiative": {
      "title": "Initiative",
      "description": "A flagship program of the foundation.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "summary": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "bullets": { "type": "array", "items": { "type": "string" } },
        "featured": { "type": "boolean" },
        "order": { "type": "number" }
      }
    },
    "FocusArea": {
      "title": "Focus Area",
      "description": "Core pillar of the foundation's work.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "iconName": { "type": "string" },
        "link": { "type": "string" },
        "order": { "type": "number" }
      }
    },
    "ImpactStat": {
      "title": "Impact Stat",
      "description": "Metric tracking foundation progress.",
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "number" },
        "suffix": { "type": "string" },
        "iconName": { "type": "string" },
        "order": { "type": "number" }
      }
    },
    "ImpactStoreItem": {
      "title": "Impact Store Item",
      "description": "A product available in the DIBF Impact Store.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "impactNote": { "type": "string" },
        "order": { "type": "number" }
      }
    },
    "NewsPost": {
      "title": "News Post",
      "description": "Article or update from the foundation.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    },
    "ImpactStory": {
      "title": "Impact Story",
      "description": "Real-world stories of foundation impact.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "beneficiary": { "type": "string" },
        "location": { "type": "string" },
        "summary": { "type": "string" },
        "story": { "type": "string" },
        "imageUrl": { "type": "string" },
        "category": { "type": "string" },
        "featured": { "type": "boolean" }
      }
    },
    "Partner": {
      "title": "Partner",
      "description": "Collaborating organization.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "logoUrl": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/siteSettings/main": { "schema": "SiteSettings", "description": "Global site configuration" },
    "/siteContent/{id}": { "schema": "SiteContent", "description": "Page-specific static content" },
    "/focusAreas/{id}": { "schema": "FocusArea", "description": "Core pillars of work" },
    "/impactStats/{id}": { "schema": "ImpactStat", "description": "Key impact metrics" },
    "/initiatives/{id}": { "schema": "Initiative", "description": "Foundation programs" },
    "/impactStore/{id}": { "schema": "ImpactStoreItem", "description": "Purpose-driven products" },
    "/news/{id}": { "schema": "NewsPost", "description": "Foundation news and insights" },
    "/impactStories/{id}": { "schema": "ImpactStory", "description": "Stories of community change" },
    "/partners/{id}": { "schema": "Partner", "description": "Global collaborators" },
    "/donations/{id}": { "schema": "object", "description": "Donation intent records" },
    "/contactMessages/{id}": { "schema": "object", "description": "Contact form submissions" }
  }
}
