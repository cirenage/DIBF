{
  "entities": {
    "Initiative": {
      "title": "Initiative",
      "description": "A flagship program or project of the foundation.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "summary": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "location": { "type": "string" },
        "imageUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "completed", "planned"] },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "slug", "description", "category"]
    },
    "NewsPost": {
      "title": "News Post",
      "description": "Updates, insights, and blog posts.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "author": { "type": "string" },
        "imageUrl": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "featured": { "type": "boolean" }
      },
      "required": ["title", "slug", "content"]
    },
    "ImpactStory": {
      "title": "Impact Story",
      "description": "Personal narratives of community impact.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "beneficiary": { "type": "string" },
        "location": { "type": "string" },
        "summary": { "type": "string" },
        "story": { "type": "string" },
        "imageUrl": { "type": "string" },
        "impactMetric": { "type": "string" },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["beneficiary", "story"]
    },
    "Partner": {
      "title": "Partner",
      "description": "Collaborating institutions and organizations.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["University", "Corporate", "Foundation", "NGO"] },
        "description": { "type": "string" },
        "logoUrl": { "type": "string" },
        "website": { "type": "string" },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "type"]
    },
    "Event": {
      "title": "Event",
      "description": "Foundation events and outreaches.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "eventDate": { "type": "string", "format": "date" },
        "imageUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["upcoming", "past", "cancelled"] },
        "registrationUrl": { "type": "string" },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "eventDate", "location"]
    },
    "TeamMember": {
      "title": "Team Member",
      "description": "Foundation leadership and staff.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "bio": { "type": "string" },
        "imageUrl": { "type": "string" },
        "order": { "type": "number" },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "role"]
    },
    "Publication": {
      "title": "Publication",
      "description": "Reports, research papers, and documents.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "summary": { "type": "string" },
        "fileUrl": { "type": "string" },
        "coverImageUrl": { "type": "string" },
        "category": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date" },
        "featured": { "type": "boolean" }
      },
      "required": ["title", "category"]
    },
    "Donation": {
      "title": "Donation",
      "description": "Restricted donation records.",
      "type": "object",
      "properties": {
        "donorName": { "type": "string" },
        "donorEmail": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "purpose": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["donorName", "amount"]
    },
    "ContactMessage": {
      "title": "Contact Message",
      "description": "Messages from the contact form.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "message"]
    },
    "VolunteerRequest": {
      "title": "Volunteer Request",
      "description": "Applications to volunteer.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "areaOfInterest": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "email"]
    },
    "PartnershipRequest": {
      "title": "Partnership Request",
      "description": "Requests for organizational partnership.",
      "type": "object",
      "properties": {
        "organizationName": { "type": "string" },
        "contactPerson": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "partnershipType": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["organizationName", "email"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/initiatives/{id}": { "schema": "Initiative", "description": "Foundation initiatives" },
    "/news/{id}": { "schema": "NewsPost", "description": "News and updates" },
    "/impactStories/{id}": { "schema": "ImpactStory", "description": "Personal narratives" },
    "/partners/{id}": { "schema": "Partner", "description": "Partner organizations" },
    "/events/{id}": { "schema": "Event", "description": "Outreaches and events" },
    "/teamMembers/{id}": { "schema": "TeamMember", "description": "Staff and leadership" },
    "/publications/{id}": { "schema": "Publication", "description": "Reports and research" },
    "/donations/{id}": { "schema": "Donation", "description": "Restricted donation records" },
    "/contactMessages/{id}": { "schema": "ContactMessage", "description": "Contact form submissions" },
    "/volunteerRequests/{id}": { "schema": "VolunteerRequest", "description": "Volunteer applications" },
    "/partnershipRequests/{id}": { "schema": "PartnershipRequest", "description": "Partnership inquiries" }
  },
  "_version": "1.0.2"
}