
{
  "entities": {
    "SiteSettings": {
      "title": "Site Settings",
      "description": "General configuration for the foundation website.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contactPhone": { "type": "string" },
        "address": { "type": "string" },
        "officeHours": { "type": "string" }
      }
    },
    "Initiative": {
      "title": "Initiative",
      "description": "A flagship program of the foundation.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "summary": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "bullets": { "type": "array", "items": { "type": "string" } },
        "featured": { "type": "boolean" },
        "order": { "type": "number" }
      }
    },
    "ImpactStoreItem": {
      "title": "Impact Store Item",
      "description": "A product available in the DIBF Impact Store.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "impactNote": { "type": "string" },
        "order": { "type": "number" }
      }
    },
    "NewsPost": {
      "title": "News Post",
      "description": "Article or update from the foundation.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/siteSettings/main": { "schema": "SiteSettings", "description": "Global site configuration" },
    "/initiatives/{id}": { "schema": "Initiative", "description": "Foundation programs" },
    "/impactStore/{id}": { "schema": "ImpactStoreItem", "description": "Purpose-driven products" },
    "/news/{id}": { "schema": "NewsPost", "description": "Foundation news and insights" },
    "/donations/{id}": { "schema": "object", "description": "Donation intent records" },
    "/contactMessages/{id}": { "schema": "object", "description": "Contact form submissions" },
    "/volunteerRequests/{id}": { "schema": "object", "description": "Volunteer applications" },
    "/partnershipRequests/{id}": { "schema": "object", "description": "Partnership inquiries" }
  }
}
