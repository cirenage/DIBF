{
  "entities": {
    "SiteSettings": {
      "title": "Site Settings",
      "description": "General configuration for the foundation website.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contactPhone": { "type": "string" },
        "address": { "type": "string" },
        "officeHours": { "type": "string" }
      }
    },
    "HeroSection": {
      "title": "Hero Section",
      "description": "Hero content for a specific page.",
      "type": "object",
      "properties": {
        "eyebrow": { "type": "string" },
        "heading": { "type": "string" },
        "body": { "type": "string" },
        "primaryCTA": { "type": "string" },
        "primaryLink": { "type": "string" },
        "secondaryCTA": { "type": "string" },
        "secondaryLink": { "type": "string" },
        "imageUrl": { "type": "string" }
      }
    },
    "Initiative": {
      "title": "Initiative",
      "description": "A flagship program of the foundation.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "summary": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "bullets": { "type": "array", "items": { "type": "string" } },
        "featured": { "type": "boolean" },
        "order": { "type": "number" }
      }
    },
    "ImpactStory": {
      "title": "Impact Story",
      "description": "Narratives of change from the field.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "body": { "type": "string" },
        "imageUrl": { "type": "string" },
        "featured": { "type": "boolean" }
      }
    },
    "TeamMember": {
      "title": "Team Member",
      "description": "Leadership and staff details.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "bio": { "type": "string" },
        "imageUrl": { "type": "string" },
        "order": { "type": "number" }
      }
    },
    "Donation": {
      "title": "Donation",
      "description": "Records of donation intent.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "donationType": { "type": "string" },
        "initiative": { "type": "string" },
        "amount": { "type": "number" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/siteSettings/main": { "schema": "SiteSettings", "description": "Global site configuration" },
    "/heroSections/{pageSlug}": { "schema": "HeroSection", "description": "Page-specific hero content" },
    "/initiatives/{id}": { "schema": "Initiative", "description": "Foundation programs" },
    "/impactStories/{id}": { "schema": "ImpactStory", "description": "Success stories" },
    "/teamMembers/{id}": { "schema": "TeamMember", "description": "Staff and leadership" },
    "/donations/{id}": { "schema": "Donation", "description": "Donation intent records" },
    "/contactMessages/{id}": { "schema": "object", "description": "Contact form submissions" },
    "/volunteerRequests/{id}": { "schema": "object", "description": "Volunteer applications" },
    "/partnershipRequests/{id}": { "schema": "object", "description": "Partnership inquiries" }
  }
}