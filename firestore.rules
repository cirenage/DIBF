rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Blanket permissions for development to resolve path-specific denials
    match /initiatives/{id} { allow read, write: if true; }
    match /news/{id} { allow read, write: if true; }
    match /impactStories/{id} { allow read, write: if true; }
    match /partners/{id} { allow read, write: if true; }
    match /events/{id} { allow read, write: if true; }
    match /teamMembers/{id} { allow read, write: if true; }
    match /publications/{id} { allow read, write: if true; }
    match /donations/{id} { allow read, write: if true; }
    match /contactMessages/{id} { allow read, write: if true; }
    match /volunteerRequests/{id} { allow read, write: if true; }
    match /partnershipRequests/{id} { allow read, write: if true; }
    
    // Explicitly allow list operations for queries
    match /{path=**}/events/{id} {
      allow read, write: if true;
    }
  }
}